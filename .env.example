# ============================================================
# IntelliFIR — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─────────────────────────────────────
# General
# ─────────────────────────────────────
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ─────────────────────────────────────
# Database
# ─────────────────────────────────────
POSTGRES_DB=intellifir
POSTGRES_USER=intellifir
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_PORT=5432
# Full URL used by the backend:
DATABASE_URL=postgresql://intellifir:change_this_password_in_production@localhost:5432/intellifir

# ─────────────────────────────────────
# Security
# ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_A_STRONG_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─────────────────────────────────────
# File Upload
# ─────────────────────────────────────
UPLOAD_DIR=./uploads             # Local path for uploaded files
MAX_UPLOAD_SIZE_MB=20

# ─────────────────────────────────────
# AI / NER Model
# ─────────────────────────────────────
# HuggingFace checkpoint for NER token classification:
# Options:
#   dslim/bert-base-NER          (English, good general purpose)
#   ai4bharat/IndicBERTv2-SS-ner (IndicBERT for Indian languages)
#   Custom fine-tuned checkpoint path
NER_MODEL_CHECKPOINT=dslim/bert-base-NER

# HuggingFace models are cached here:
MODELS_CACHE_DIR=./models_cache

# ─────────────────────────────────────
# Sentence Transformers (Embeddings)
# ─────────────────────────────────────
# Options:
#   all-MiniLM-L6-v2    (fast, 384 dim)
#   all-mpnet-base-v2   (accurate, 768 dim)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─────────────────────────────────────
# FAISS Vector Store
# ─────────────────────────────────────
FAISS_INDEX_PATH=./faiss_index
SIMILARITY_THRESHOLD=0.5         # Minimum similarity score for retrieval (0.0–1.0)

# ─────────────────────────────────────
# LLM Provider (Optional)
# ─────────────────────────────────────
# Options:
#   none     — disable LLM, use template-based generation only
#   ollama   — local Ollama server
LLM_PROVIDER=none

# Ollama configuration (used when LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─────────────────────────────────────
# CORS
# ─────────────────────────────────────
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000

# ─────────────────────────────────────
# Frontend (Vite build-time variables)
# ─────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=false

# ─────────────────────────────────────
# Demo Mode
# ─────────────────────────────────────
# When DEMO_MODE=true:
# - Sample fictional complaints are pre-loaded
# - Demo banner is shown in the UI
# - No real data is required
DEMO_MODE=false

# ─────────────────────────────────────
# Docker Ports (optional overrides)
# ─────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80

# ─────────────────────────────────────
# Privacy Notice
# ─────────────────────────────────────
# IntelliFIR handles sensitive complaint information.
# - Configure LLM_PROVIDER=none to disable external AI calls.
# - Only use verified, locally hosted models for sensitive deployments.
# - Review the PRIVACY.md file before deploying with real complaint data.
# - Ensure POSTGRES_PASSWORD and SECRET_KEY are strong random values in production.
